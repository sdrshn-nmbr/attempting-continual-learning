{
  "question": "Does a fixed total support of 32 old training examples preserve global acquisition and at least 90 percent final old-task accuracy relative to a fresh full-history replay control with identical current-example and replay-class exposures?",
  "dataset": {
    "id": "clinc/clinc_oos",
    "revision": "155b9c710419136e17307b80d0a13e68cd46b4ec",
    "subset": "small",
    "license": "cc-by-3.0",
    "source": "https://huggingface.co/datasets/clinc/clinc_oos/tree/155b9c710419136e17307b80d0a13e68cd46b4ec",
    "attribution": "Stefan Larson et al., An Evaluation Dataset for Intent Classification and Out-of-Scope Prediction, EMNLP-IJCNLP 2019",
    "paper": "https://aclanthology.org/D19-1131/",
    "split_counts": {
      "train": 7600,
      "validation": 3100,
      "test": 5500
    },
    "transformation": "Exclude oos; seed class order and independently permute letter codes; sample balanced disjoint official splits; normalize text to remove exact cross-split duplicates. No semantic near-duplicate or pretraining-contamination guarantee."
  },
  "objective": "Cross-entropy over the fixed full set of selected single-token letter codes at the final prompt position. Base model, embeddings, and LM head frozen; only text MLP LoRA weights train. No labels, examples, task identity, class descriptions, or code mapping in the prompt. This is constrained classification, not free generation or full-vocabulary language-model loss.",
  "model": {
    "model_id": "Qwen/Qwen3.5-4B",
    "revision": "851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a",
    "model_path": "/mnt/shared/cl-smoke/models/Qwen/Qwen3.5-4B/851bf6e806efd8d0a36b00ddf55e13ccb7b8cd0a"
  },
  "methods": {
    "balanced_replay": "One method per run. Carry LoRA weights and AdamW state across all four tasks; no boundary resets. The two fresh runs differ only in replay_capacity: null for full history, 32 for bounded candidate support."
  },
  "replay_support": {
    "scope": "Bounded replay candidate support only. The loader and shared scheduling metadata still contain historical rows; this is not a physical bounded host-RAM claim.",
    "eligible_rows": "Only selected official TRAIN examples. After each completed task, form candidates from the previously retained members plus the newly completed task. Never add an old row that was absent from the previous buffer.",
    "quota_rule": "Assign floor(min(capacity, available examples) / seen classes) per class and one extra to the lowest learned letter codes until the remainder is used. Old-class quotas never increase as classes are added; class counts differ by at most one. Full history retains every candidate.",
    "retention_order": "Within each class, retain the lowest derived_seed(seed, replay_retention, source_task_index, selected_train_row_index) priorities. Canonically sort retained reference pairs. Decisions use no validation/test values or model scores.",
    "sampling": "Both capacities use the original full-class permutations, class draws and mixed-batch shuffle RNG. Filter each class permutation to the active retained members and cycle those members until the next full-class permutation is drawn. Full-class permutation consumption fixes the shared RNG trajectory and mixing positions. All actual trainer replay references must belong to the active buffer.",
    "full_identity": "With unlimited support, every candidate is retained and filtering is the identity: candidate queues equal the original full queues, consume in the same order, and leave every original RNG call and training reference unchanged. This is one sampler, not a separate legacy implementation.",
    "activation": "The engine updates active replay members only after a task completes, checks them against the deterministic prepared plan, logs actual before/after members, per-class counts and membership SHA256, and checkpoints the active buffer. Every update validates old references before forward/backward.",
    "members_reference_format": "[source_task_index, selected_train_row_index]; the selected-row data provenance binds each reference to text and tokens.",
    "full_examples_after_tasks": [
      128,
      256,
      384,
      512
    ],
    "bounded_examples_after_tasks": [
      32,
      32,
      32,
      32
    ],
    "bounded_quotas_after_tasks": [
      "8 per class across 4 classes",
      "4 per class across 8 classes",
      "2 or 3 per class across 12 classes",
      "2 per class across 16 classes"
    ]
  },
