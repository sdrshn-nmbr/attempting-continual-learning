      "full": "support-full-seed47.json",
      "bounded": "support-32-seed47.json"
    },
    "reserved_policy": "Prepared only. No automatic dispatch, retry, confirmation or tuning.",
    "only_config_difference_within_pair": "replay_capacity",
    "matching": "Identical pinned model/base weights, initialization seed and initial LoRA, task/code/sample selections, rank/alpha/targets, optimizer hyperparameters, prompt/tokenization, update/microbatch/accumulation/evaluation schedules. Current row references and replay class codes match at every batch position.",
    "seed_interpretation": "Each seed jointly fixes task selection/order, code mapping, samples, retention priorities and initialization. A second seed is a controlled repetition, not a significance claim.",
    "tasks": 4,
    "classes_per_task": 4,
    "updates_per_task": 32,
    "updates_per_arm": 128,
    "effective_batch_size": 8,
    "replay_fraction_after_task_zero": 0.5,
