  "reproduction_commands": {
    "gemma_one_thread": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/Users/sudarshan/Documents/Codex/2026-09-05/i-want-you-to-run-extensive/experiments/catalog uv run --no-project --python 3.12 --with torch==2.10.0 --with transformers==5.16.1 --with peft==0.20.0 --with portallib==0.2.1 --with pyarrow==25.0.1 python -B - <<'PY'\nfrom pathlib import Path\nimport json\nimport torch\nfrom torch import nn\nfrom peft import PeftModel\nfrom safetensors.torch import load_file\nfrom factory import load_portal\nfrom portallib.evaluation import PortalInjector\n\ntorch.set_num_threads(1)\nroot = Path('experiments/catalog')\nmanifest = json.loads((root/'manifest.json').read_text())\nentry = next(e for e in manifest['models'] if e['name'] == 'portal-gemma-4-e2b')\nportal = load_portal(manifest, entry, root/'outputs/cpu-cache')\ntargets = list(portal.config.resolved_targets())\nexport = root/'outputs/cpu-verification'/entry['name']/'peft/boolq'\nraw = load_file(export/'adapter_model.safetensors')\nprint(json.dumps({'raw_keys_head': list(raw)[:4], 'torch_threads': torch.get_num_threads()}), flush=True)\n\nclass SyntheticProjectionModel(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.config = {'model_type': entry['model_type'], 'tie_word_embeddings': False}\n        for target, path in targets:\n            parts = path.split('.')\n            node = self\n            for part in parts[:-1]:\n                if part not in node._modules:\n                    node.add_module(part, nn.Module())\n                node = node._modules[part]\n            projection = nn.Linear(target.in_features, target.out_features, bias=False, dtype=torch.bfloat16)\n            with torch.no_grad():\n                projection.weight.normal_(mean=0.0, std=0.01)\n            node.add_module(parts[-1], projection)\n    def prepare_inputs_for_generation(self, *args, **kwargs):\n        return kwargs\n    def forward(self, inputs):\n        return {path: self.get_submodule(path)(inputs[target.in_features]) for target, path in targets}\n\ntorch.manual_seed(704)\nmodel = SyntheticProjectionModel().eval()\ninputs = {target.in_features: torch.randn(2,3,target.in_features, dtype=torch.bfloat16) for target, path in targets}\nwith torch.inference_mode():\n    factors = portal.generate('boolq')\n    base = model(inputs)\n    injector = PortalInjector(model, portal.config)\n    with injector.activate(factors):\n        native = model(inputs)\n    injector.close()\n    clean = all(torch.equal(base[p], v) for p,v in model(inputs).items())\n    wrapped = PeftModel.from_pretrained(model, export, is_trainable=False, autocast_adapter_dtype=False)\n    peft_outputs = wrapped.base_model.model(inputs)\n    mismatches = []\n    factor_mismatches = []\n    for target, path in targets:\n        module = wrapped.base_model.model.get_submodule(path)\n        a, b = factors[target.key]\n        factors_actual = (module.lora_A['default'].weight, module.lora_B['default'].weight)\n        factor_errors = [float((x.to(torch.bfloat16).float()-y.float()).abs().max()) for x,y in zip((a,b), factors_actual)]\n        raw_errors = [float((x.float()-raw[f'base_model.model.{path}.lora_{letter}.weight'].float()).abs().max()) for x,letter in zip((a,b),('A','B'))]\n        if any(factor_errors) or any(raw_errors):\n            factor_mismatches.append({'path': path, 'factor_errors_bf16': factor_errors, 'raw_errors_fp32': raw_errors})\n        error = float((native[path]-peft_outputs[path]).abs().max())\n        if error:\n            mismatches.append({'path': path, 'max_error': error, 'native_abs_max': float(native[path].abs().max()), 'peft_abs_max': float(peft_outputs[path].abs().max()), 'factor_errors':factor_errors, 'scaling_native': portal.config.scaling, 'scaling_peft': module.scaling})\n    print(json.dumps({'model':entry['name'], 'unique_base_weights':len({model.get_submodule(p).base_layer.weight.data_ptr() for _,p in targets}), 'targets':len(targets),'hooks_removed_cleanly':clean,'mismatches': mismatches,'factor_mismatches': factor_mismatches}), flush=True)\nPY"
  },
